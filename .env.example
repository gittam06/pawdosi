# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---------------------------------------------------------------
# Project Settings -> Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used by the seed script, never in app code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary -------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# Server-only. Signs uploads and deletes assets. Must never reach the client.
CLOUDINARY_API_SECRET=

# --- Feature flags ----------------------------------------------------------
# Set to "true" only after enabling the Google provider in Supabase Auth and
# adding <your-url>/auth/callback as an authorised redirect URL.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# --- App --------------------------------------------------------------------
# Absolute base URL, used for metadata and OAuth redirects.
# Vercel sets this per environment; locally the default is http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
